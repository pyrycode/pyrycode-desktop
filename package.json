{
  "name": "pyrycode-desktop",
  "version": "0.1.0",
  "description": "Electron desktop remote head for the pyry daemon.",
  "main": "./out/main/index.js",
  "author": "Juhana Ilmoniemi <juhana@ilmoniemi.fi>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "check:electron-digest": "ELECTRON_RUN_AS_NODE=1 electron scripts/electron-digest-check.mjs",
    "check:docs": "node scripts/docs-guard.mjs",
    "e2e": "npm run build && playwright test",
    "e2e:real-claude": "npm run build && playwright test --config playwright.real-claude.config.ts",
    "e2e:real:gate": "npm run build && playwright test --config playwright.real-claude.config.ts --reporter=list,./e2e/reporters/zeroExecutedGate.ts"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "mdast-util-gfm-table": "^2.0.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "noise-c.wasm": "^0.4.0",
    "react-markdown": "^10.1.0",
    "ws": "^8.21.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark-parse": "^11.0.0",
    "typescript": "^5.7.2",
    "unified": "^11.0.5",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
